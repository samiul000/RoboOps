# Selected Active Provider: [ollama | openai | anthropic | truefoundry]
ACTIVE_AI_PROVIDER=ollama

# Local Ollama (Runs on Windows)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# Cloud Fallbacks / Incident Commander
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Daytona Sandbox (Optional cloud execution or local container)
DAYTONA_API_KEY=your_daytona_api_key